# --- Phase 2: Legacy cruise URL redirects (point directly at canonical trailing-slash URLs) ---
/destinations                            /cruise-destinations/                       301
/destinations/beach-coast-cruise         /cruise-destinations/                       301
/destinations/full-waterway-tour         /cruise-destinations/                       301
/destinations/las-olas-cruise            /las-olas-boat-tour/                        301
/destinations/sandbar-party              /north-bound-scenic-cruise/                 301
/destinations/intracoastal-tour          /intracoastal-waterway-corporate-cruise/    301

# --- Force trailing slash on canonical page URLs ---
# Without these, the SPA fallback below catches /blog and serves index.html (homepage) with 200.
/cruise-destinations                     /cruise-destinations/                       301
/faq                                     /faq/                                       301
/contact-us                              /contact-us/                                301
/gallery                                 /gallery/                                   301
/blog                                    /blog/                                      301
/new-river-cruise                        /new-river-cruise/                          301
/north-bound-scenic-cruise               /north-bound-scenic-cruise/                 301
/las-olas-boat-tour                      /las-olas-boat-tour/                        301
/intracoastal-waterway-corporate-cruise  /intracoastal-waterway-corporate-cruise/    301
/fort-lauderdale-sunset-cruise           /fort-lauderdale-sunset-cruise/             301
/pontoon-boat-rental-fort-lauderdale     /pontoon-boat-rental-fort-lauderdale/       301
/privacy-policy                          /privacy-policy/                            301
/terms-of-service                        /terms-of-service/                          301
/cancellation-policy                     /cancellation-policy/                       301

# Blog post slug canonicalization lives in netlify/edge-functions/blog-trailing-slash.js.
# It can NOT be a rule here: redirect matching ignores trailing slashes, so any
# "/blog/... -> /blog/.../" rule also matches the slash form and 301-loops on every
# blog URL with no static file (deleted/unpublished/mistyped posts).

# --- Branded media URLs: proxy Supabase storage through our own domain ---
# Public pages render /images/... (see src/lib/siteImageUrl.ts); Netlify fetches
# from the bucket behind the scenes so visitors never see the Supabase URL.
/images/gallery/*  https://vjiybpiuquttbaimywbt.supabase.co/storage/v1/object/public/gallery-photos/:splat   200
/images/blog/*     https://vjiybpiuquttbaimywbt.supabase.co/storage/v1/object/public/tiki-blog-images/:splat  200
/images/site/*     https://vjiybpiuquttbaimywbt.supabase.co/storage/v1/object/public/pontoon/:splat           200

# --- Admin SPA fallback (client-only routes, never prerendered) ---
/admin      /index.html   200
/admin/*    /index.html   200

# No catch-all on purpose: URLs with no static file and no rule above fall
# through to dist/404.html, which Netlify serves with a real 404 status.
# (A "/* /index.html 200" catch-all here would soft-404 every bogus URL.)
